---
import CourseLayout from "../../layouts/CourseLayout.astro";
import AcademyScene from "../../components/AcademyScene.astro";
import PassportTools from "../../components/PassportTools.astro";
import {weeks} from "../../data/curriculum";
import {withBase} from "astro-theme-university/url";
---
<CourseLayout title="Online practice academy" description="Equivalent online activities for students unable to attend in person, plus preparation and revision between campus classes." eyebrow="SLOP UNIVERSITY / TRAINING GROUND" wide>
<div class="academy-start"><div><h2>Your online practical environment.</h2><p>Explore a room to see its equipment, then open its weekly lab for the actual task, instructions and saved attempts. Exploring the atrium does not complete a lab.</p><p><strong>First visit:</strong> read the <a href={withBase("/course-guide/")}>course guide</a> and weekly briefing before opening a lab. <strong>Returning:</strong> choose any week; you do not need to unlock rooms.</p></div><div class="actions"><a class="button primary" href={withBase("/sessions/week-01/")}>Start Lab 1: Read the Room ↗</a><a class="button" href={withBase("/operation/")}>Go to the final mission ↗</a></div></div>
<p class="small"><strong>Look around:</strong> click and drag the scene. In fullscreen, press X to lock the cursor for mouse-look; press X again to free it for controls. <strong>Get closer:</strong> scroll over the scene or use the zoom controls. The room and lab links remain available for direct navigation.</p>
<AcademyScene room="atrium" mode="academy"/>
<section><p class="eyebrow">DIRECT ACCESS / ALL TWELVE WEEKS</p><h2>Choose a capability.</h2><div class="skill-rows">{weeks.map(w=><a href={withBase("/sessions/week-"+String(w.week).padStart(2,"0")+"/")}><span class="skill-number">{String(w.week).padStart(2,"0")}</span><span><strong>{w.title}</strong><small>{w.room} · {w.skill}</small></span><span aria-hidden="true">↗</span></a>)}</div></section>
<section class="callout"><p class="eyebrow">WATCH · INSPECT · TAKE CONTROL</p><h2>See a complete worked example.</h2><p>Sixteen guided 3D scenarios show the learning process and a finished submission. Follow the coach, then take over the apparatus yourself.</p><a class="button primary" href={withBase("/demonstrations/")}>Enter the demonstration studio ↗</a></section>
<PassportTools/>
</CourseLayout>
