---
import CourseLayout from "../../layouts/CourseLayout.astro";
import AcademyScene from "../../components/AcademyScene.astro";
import ExampleDocument from "../../components/ExampleDocument.astro";
import {demonstrations} from "../../data/demonstrations";
import {getDemoWalkthrough} from "../../data/demonstration-walkthroughs";
import {withBase} from "astro-theme-university/url";
import "../../styles/demonstration.css";
export function getStaticPaths(){return demonstrations.map(demo=>({params:{id:demo.id},props:{demo}}));}
const {demo}=Astro.props;
const walkthrough=getDemoWalkthrough(demo);
const json=JSON.stringify(demo).replaceAll("<","\\u003c");
---
<CourseLayout title={demo.title} description={demo.subtitle} eyebrow="THE DEMONSTRATION STUDIO / WATCH · INSPECT · TAKE CONTROL" wide>
<article class="demo-player" data-demo-id={demo.id}>
<script is:inline type="application/json" data-demo-definition set:html={json}/>
<div class="demo-start"><h2>Start this worked example</h2><ol><li>Choose <strong>Watch the worked example</strong>. The student demonstrator explains the task, talks through each action, then reviews the observations and finished submission. Narration starts with this click; <strong>Mute narration</strong> keeps the same experience captioned.</li><li>Choose <strong>Take control</strong> to try the current chapter. Follow its prompt, change the labelled controls and select <strong>Test my decision</strong>.</li><li>Read the feedback, retry if needed, then continue with <strong>Next chapter</strong>. You can also open any chapter directly.</li><li>Use <strong>Fullscreen mission</strong> after opening the scene to keep the instructions, chapter controls and equipment together. Reflections and exports come after your practical attempt.</li></ol><p>This is an alternate example, not your assigned exercise. Your course task is linked after the player.</p></div>
<div class="demo-context"><div><p class="eyebrow">YOUR SKILL</p><p>{demo.skill}</p></div><div><p class="eyebrow">A NEW SETTING</p><p>{demo.setting}</p></div><div><p class="eyebrow">WHAT CHANGES</p><p>{demo.difference}</p></div></div>
<div class="demo-mode-bar" data-immersive-panel><div role="group" aria-label="Demonstration mode"><button type="button" class="primary" data-demo-watch disabled>Watch the worked example</button><button type="button" data-demo-control disabled>Take control</button></div><span data-demo-mode-label>Choose how you want to learn.</span></div>
<div class="demo-theatre">
 <AcademyScene room={demo.steps[0]!.before.room} mode="demo" contextId={'demo:'+demo.id}/>
 <div class="demo-caption" data-immersive-panel><span data-demo-chapter>01 / {demo.steps.length}</span><div><span class="demo-narration-phase" data-demo-narration-phase>Before we begin</span><strong data-demo-caption-title>Your worked-example briefing</strong><p data-demo-caption>{walkthrough.introduction}</p></div></div>
</div>
<div class="demo-transport" data-immersive-panel role="group" aria-label="Playback and chapter controls">
 <button type="button" data-demo-previous disabled>← Previous</button><button type="button" data-demo-play disabled>Play</button><button type="button" data-demo-next disabled>Next chapter →</button>
 <label>Playback pace<select data-demo-speed><option value="0.7">Unhurried</option><option value="1" selected>Standard</option><option value="1.35">Brisk</option></select></label>
 <button type="button" data-demo-replay disabled>Replay chapter</button>
 <button type="button" data-demo-narrate aria-pressed="true" disabled>Mute narration</button>
 <button type="button" data-demo-introduction disabled>Replay introduction</button>
 <button type="button" data-demo-completion disabled>Review observations &amp; submission</button>
 <p class="demo-audio-status" data-demo-audio-status role="status">Narration starts after you choose Watch or Play. Captions remain available if this browser has no working voice.</p>
</div>
<div class="demo-progress"><div data-demo-progress-bar></div></div>
<p data-demo-status class="demo-status" data-immersive-panel role="status" aria-live="polite">The complete transcript and finished example are available below while the player loads.</p>
<div class="demo-learning-grid" data-immersive-panel>
 <section class="demo-coach" aria-labelledby="demo-step-heading"><p class="eyebrow" data-demo-step-eyebrow>THE DEMONSTRATOR’S REASONING</p><h2 id="demo-step-heading" data-demo-step-title>{demo.steps[0]!.title}</h2><p data-demo-narration>{demo.steps[0]!.narration}</p>
 <details open data-demo-why><summary>Why this matters</summary><p data-demo-why-text>{demo.steps[0]!.why}</p></details>
 <details data-demo-pitfall><summary>A plausible mistake</summary><p data-demo-pitfall-text>{demo.steps[0]!.pitfall}</p></details>
 <div class="demo-observed" data-demo-observed hidden><p class="eyebrow">WHAT THE DEMONSTRATOR DID</p><dl data-demo-action-summary></dl><p data-demo-outcome></p></div>
 </section>
 <section class="demo-practice" aria-labelledby="demo-practice-heading"><p class="eyebrow">YOUR LEARNING CONTROLS</p><h2 id="demo-practice-heading">Make the skill your own.</h2>
 <label>Coaching style<select data-demo-coaching><option value="guided">Explain as I go</option><option value="independent">Let me attempt it first</option><option value="challenge">Keep hints on request</option></select></label>
 <p data-demo-prompt>{demo.steps[0]!.prompt}</p>
 <form data-demo-form hidden><div data-demo-inputs></div><button class="primary" type="submit">Test my decision</button></form>
 <p data-demo-watch-note>Watch the apparatus change as the student demonstrates. Take control whenever you want to test the same idea yourself.</p>
 <div class="actions"><button type="button" data-demo-hint disabled>Give me a cue</button></div>
 <p data-demo-hint-text hidden></p><p data-demo-feedback role="status" aria-live="polite"></p>
 <div class="demo-coaching-result"><p class="eyebrow">BASED ON YOUR ATTEMPTS</p><p data-demo-coaching-result>Watching and practising are recorded separately in this visit. These examples do not change your assessed work or skills passport.</p></div>
 </section>
</div>
<nav class="demo-chapters" data-immersive-panel aria-label="Demonstration chapters">{demo.steps.map((step,i)=><button type="button" data-demo-jump={i} disabled aria-current={i===0?"step":undefined}><span>{String(i+1).padStart(2,"0")}</span><strong>{step.title}</strong><small data-demo-chapter-state>Ready to explore</small></button>)}</nav>
<section class="demo-transfer" data-immersive-panel><p class="eyebrow">NOW TRANSFER THE SKILL</p><h2>Carry the method into your own work.</h2><p>{demo.transfer}</p><div class="actions"><a class="button primary" href={withBase(demo.sourceHref)}>{demo.sourceLabel} ↗</a><button type="button" data-demo-export disabled>Export my demonstration record</button><button type="button" data-demo-reset disabled>Restart this example</button></div><dialog data-demo-reset-dialog><h2>Restart this worked example?</h2><p>This clears its practice record for this visit. Your course passport and assigned activities stay saved.</p><div class="actions"><button type="button" data-demo-reset-confirm>Restart example</button><button type="button" data-demo-reset-cancel>Keep this example</button></div></dialog></section>
<section class="demo-finished" data-immersive-panel><p class="eyebrow">A COMPLETE WORKED SUBMISSION</p><h2>{demo.artifact.title}</h2><p>Example work from this demonstration's scenario. Use it to understand the expected evidence and explanation, then make your own decisions in the assigned activity.</p><a class="button" data-demo-download href={withBase("/examples/"+demo.id+".md")} download={demo.artifact.filename}>Download the complete example</a><details><summary>Read the finished work</summary><ExampleDocument markdown={demo.artifact.markdown}/></details></section>
<details class="demo-transcript" data-immersive-panel><summary>Complete transcript and decisions · readable without JavaScript</summary><div class="demo-transcript-bookend"><h3>Before we begin · expected task and evidence</h3><p>{walkthrough.introduction}</p></div>{demo.steps.map((step,i)=><section><h3>{i+1}. {step.title}</h3><p><strong>What I need to do:</strong> {walkthrough.steps[step.id]!.briefing}</p><p><strong>Supplied context:</strong> {step.narration}</p><p><strong>Watch my actions:</strong> {walkthrough.steps[step.id]!.action}</p><p><strong>What I observed:</strong> {walkthrough.steps[step.id]!.outcome}</p><p><strong>Why:</strong> {step.why}</p><p><strong>Decision:</strong> {step.prompt}</p><ul>{step.controls.map(c=><li>{c.label}: {Array.isArray(c.expected)?c.expected.map(value=>c.options?.find(o=>o.value===value)?.label??value).join(" → "):typeof c.expected==="boolean"?(c.expected?"Yes":"No"):c.options?.find(o=>o.value===String(c.expected))?.label??String(c.expected)}{c.unit?" "+c.unit:""}</li>)}</ul><p><strong>Result:</strong> {step.success}</p><p><strong>Common mistake:</strong> {step.pitfall}</p></section>)}<div class="demo-transcript-bookend"><h3>My observations and finished submission</h3><p>{walkthrough.completion}</p><p>The complete submission is available in <strong>Read the finished work</strong> above and as a Markdown download.</p></div></details>
<noscript><p class="callout">The full teaching transcript and worked submission above are available without JavaScript. Live playback and apparatus controls require JavaScript.</p></noscript>
</article>
<p class="actions"><a class="button" href={withBase("/demonstrations/")}>← All worked examples</a></p>
</CourseLayout>
<script>import "../../scripts/demonstration-client";</script>