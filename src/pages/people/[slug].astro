---
import {render} from "astro:content";
import {getPublishedCollection} from "astro-course-university/content";
import CourseLayout from "../../layouts/CourseLayout.astro";
export async function getStaticPaths(){return (await getPublishedCollection("people")).map(person=>({params:{slug:person.id},props:{person}}));}
const {person}=Astro.props;const {Content}=await render(person);
---
<CourseLayout title={person.data.title} description={person.data.description} eyebrow="THE ACADEMY / FACULTY"><Content/><div class="callout"><p>{person.data.contact}</p></div></CourseLayout>
