---
import {render} from "astro:content";
import {getPublishedCollection} from "astro-course-university/content";
import {withBase} from "astro-theme-university/url";
import CourseLayout from "../../layouts/CourseLayout.astro";
import MarkingModel from "../../components/MarkingModel.astro";
import {formatCourseDate} from "../../lib/dates";
export async function getStaticPaths(){return (await getPublishedCollection("assessments")).map(assessment=>({params:{slug:assessment.id},props:{assessment}}));}
const {assessment}=Astro.props;const {Content}=await render(assessment);
const sessions=assessment.id==="fieldwork"?(await getPublishedCollection("sessions")).sort((a,b)=>a.data.week-b.data.week):[];
---
<CourseLayout title={assessment.data.title} description={assessment.data.description} eyebrow="ASSESSMENT / THE CONTRACT">
<div class="fact-strip"><span>{assessment.data.weight}% of course</span><span>{String(assessment.data.participation)}</span><span>Due {formatCourseDate(assessment.data.due)} · 17:00 Canberra</span></div>
<div class="actions"><a class="button" href={withBase("/templates/"+assessment.id+".md")} download>Download assessment template</a><a class="button" href={withBase("/operation/")}>Export your practice dossier</a></div>
<Content />
{assessment.data.marking&&<MarkingModel marking={assessment.data.marking}/>}
{sessions.length>0&&<section><h2>Fieldwork checkpoints</h2><ul>{sessions.map(s=><li><a href={withBase("/sessions/"+s.id+"/")}>Week {s.data.week} — {s.data.title}</a>: {formatCourseDate(s.data.date)}, 17:00.</li>)}</ul></section>}
</CourseLayout>
