---
import {render} from "astro:content";
import StudyRoutes from "../../components/StudyRoutes.astro";
import {getPublishedCollection} from "astro-course-university/content";
import {withBase} from "astro-theme-university/url";
import CourseLayout from "../../layouts/CourseLayout.astro";
import TrainingLab from "../../components/TrainingLab.astro";
import PassportTools from "../../components/PassportTools.astro";
import DemonstrationLink from "../../components/DemonstrationLink.astro";
import {formatCourseDate} from "../../lib/dates";
export async function getStaticPaths(){return (await getPublishedCollection("sessions")).map(session=>({params:{slug:session.id},props:{session}}));}
const {session}=Astro.props;const {Content}=await render(session);const week=session.data.week;
---
<CourseLayout title={session.data.title} description={session.data.description} eyebrow={"LAB / WEEK "+String(week).padStart(2,"0")} wide>
<div class="fact-strip"><span>{formatCourseDate(session.data.date)}</span><span>2-hour lab</span><span>Fieldwork due 17:00 Canberra</span></div>
<StudyRoutes week={week}/>
<nav class="actions" aria-label="Lab resources"><a class="button" href="#lab-guide">Read the complete lab instructions ↓</a><a class="button primary" href="#exercise">Open online lab ↓</a><a class="button" href={withBase("/lectures/week-"+String(week).padStart(2,"0")+"/")}>Read the briefing</a><a class="button" download href={withBase("/campus/week-"+String(week).padStart(2,"0")+".md")}>Download campus pack</a></nav>
<p class="small"><strong>For online participation and revision:</strong> follow the Lab mission checklist and named controls below. Complete the verified intervention and receiving handover; explain and save that attempt before switching phases. <strong>Need an example first?</strong> The demonstration uses a different scenario and keeps separate practice progress.</p>
<DemonstrationLink id={"lab-"+String(week).padStart(2,"0")}/>
<div id="exercise"><TrainingLab week={week}/></div>
<PassportTools compact/>
<section id="lab-guide" class="teaching-reading" aria-label="Complete lab instructions"><Content/></section>
<nav class="actions" aria-label="Week navigation">{week>1&&<a class="button" href={withBase("/sessions/week-"+String(week-1).padStart(2,"0")+"/")}>← Previous lab</a>}<a class="button" href={withBase("/sessions/")}>All labs</a>{week<12&&<a class="button" href={withBase("/sessions/week-"+String(week+1).padStart(2,"0")+"/")}>Next lab →</a>}</nav>
</CourseLayout>
