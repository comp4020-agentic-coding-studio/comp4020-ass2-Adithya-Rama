---
import {render} from "astro:content";
import {getPublishedCollection} from "astro-course-university/content";
import {withBase} from "astro-theme-university/url";
import CourseLayout from "../../layouts/CourseLayout.astro";
import Activity from "../../components/Activity.astro";
import {formatCourseDate} from "../../lib/dates";
export async function getStaticPaths(){return (await getPublishedCollection("sessions")).map(session=>({params:{slug:session.id},props:{session}}));}
const {session}=Astro.props;const {Content}=await render(session);const week=session.data.week;
---
<CourseLayout title={session.data.title} description={session.data.description} eyebrow={"LAB / WEEK "+String(week).padStart(2,"0")}>
<div class="fact-strip"><span>{formatCourseDate(session.data.date)}</span><span>2-hour lab</span><span>Fieldwork due 17:00 Canberra</span></div>
<p><a href={withBase("/lectures/week-"+String(week).padStart(2,"0")+"/")}>Read the briefing</a> · <a href="#exercise">Go to the exercise</a> · <a href={withBase("/operation/")}>Open your dossier</a></p>
<Content />
<div id="exercise"><Activity week={week}/></div>
</CourseLayout>
