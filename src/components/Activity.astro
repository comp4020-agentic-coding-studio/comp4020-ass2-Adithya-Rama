---
import { activityForWeek,caseById } from "../data/academy";
import { withBase } from "astro-theme-university/url";
interface Props {week:number; showCases?:boolean}
const {week,showCases=true}=Astro.props;
const a=activityForWeek(week);
---
<section class="workbench activity" data-activity={a.id} aria-labelledby={"activity-"+a.id}>
  <header><p class="eyebrow">FIELD EXERCISE / {String(week).padStart(2,"0")}</p><h2 id={"activity-"+a.id}>{a.title}</h2></header>
  <p>{a.prompt}</p>
  {showCases&&a.caseIds.map(id=>{const c=caseById(id);return <details><summary>{c.id} — {c.title}</summary><p class="small">{c.authority}</p><p>{c.body}</p></details>;})}
  <form data-activity-form={a.id}>
    {a.kind==="choose"&&<fieldset><legend>Your interpretation</legend>{a.options?.map(o=><label class="choice-label"><input type="radio" name="choice" value={o.id} required/><span>{o.label}</span></label>)}</fieldset>}
    {a.kind==="classify"&&a.statements?.map(s=><fieldset data-statement={s.id}><legend>{s.text}</legend><label for={a.id+"-"+s.id+"-category"}>Evidence category</label><select id={a.id+"-"+s.id+"-category"} name={s.id+"-category"} required><option value="">Choose a category</option><option value="observation">Observation</option><option value="claim">Claim</option><option value="assumption">Assumption</option></select><label for={a.id+"-"+s.id+"-confidence"}>Your confidence</label><select id={a.id+"-"+s.id+"-confidence"} name={s.id+"-confidence"}><option value="medium">Medium</option><option value="low">Low</option><option value="high">High</option></select></fieldset>)}
    {a.kind==="order"&&<div><p class="small">Current sequence. With JavaScript enabled, use the buttons to reorder.</p><ol class="order-list" data-order-list>{a.items?.map(item=><li data-item={item}><span class="order-text">{item}</span><span class="order-controls"><button type="button" data-move="-1" disabled aria-label={"Move "+item+" up"}>↑ Up</button><button type="button" data-move="1" disabled aria-label={"Move "+item+" down"}>↓ Down</button></span></li>)}</ol></div>}
    <label for={a.id+"-reflection"}>{a.reflection}</label>
    <textarea id={a.id+"-reflection"} name="reflection" maxlength="8000" required placeholder="Record your reasoning and cite the case file." rows="5"></textarea>
    <div class="actions"><button class="primary" type="submit" disabled data-save>Save to dossier & review</button><button type="button" data-sample disabled>Use example response</button><button type="button" data-hint disabled>Reveal a hint</button></div>
    <p class="status" role="status" data-activity-status></p>
    <div data-feedback hidden class="feedback"></div>
  </form>
  <p class="status" role="status" data-global-status>Save your response, then export a backup before leaving this tab.</p>
  <div class="actions"><button type="button" data-export="json" disabled>Export backup JSON</button><button type="button" data-export="markdown" disabled>Export dossier Markdown</button><button type="button" data-print disabled>Print worksheet</button></div>
  <p class="small">Exports include saved responses from this dossier. Save changes above before downloading.</p>
  <details><summary>Worksheet, feedback and exemplar</summary><p><strong>Output:</strong> {a.output}. Read the case files, complete the task on paper or in your own document, and answer the reflection prompt above.</p>{a.items&&<p>Arrange: {a.items.join(" / ")}.</p>}{a.statements&&<ul>{a.statements.map(s=><li>{s.text} — {s.answer}. {s.explanation}</li>)}</ul>}{a.options&&<ul>{a.options.map(o=><li><strong>{o.label}.</strong> {o.feedback}</li>)}</ul>}<p><strong>Worked response:</strong> {a.exemplar}</p><p>This is one response to inspect, not a grade or a required script. Explain what your own answer assumes.</p></details>
  {week===7&&<div data-plan-comparison><p class="small">Save a revision to compare it with your preserved original. A labelled sample Version 1 is supplied when you arrive directly.</p></div>}
  {week>=11&&<p><a href={withBase("/operation/#rehearsal")}>Open the six-checkpoint rehearsal</a>. All presets are available immediately.</p>}
  <noscript><p>The interactive controls need JavaScript. The complete worksheet and explanation above remain available; record your answers in your own document.</p></noscript>
</section>
<script>import "../scripts/academy-client";</script>
