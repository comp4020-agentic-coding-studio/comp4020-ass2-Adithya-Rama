---
import '../styles/world.css';
import '../styles/immersive.css';
interface Props { room: string; week?: number; mode?: 'academy' | 'lab' | 'mission' | 'hero' | 'demo' }
const { room, week = 0, mode = 'lab' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const roomNames: Record<string,string> = { atrium:'Academy atrium', perception:'Perception Gallery', spatial:'Spatial Lab', mechanics:'Mechanics Workshop', systems:'Systems Garage', digital:'Digital Observatory', council:'Council Studio', movement:'Movement Hall', operations:'Operations Studio', meridian:'Meridian Station' };
const weekRooms=['atrium','perception','perception','spatial','mechanics','systems','digital','digital','council','council','movement','operations','operations']; const resolvedRoom=/^\d+$/.test(room)?weekRooms[Number(room)]||'atrium':room; const title = roomNames[resolvedRoom] ?? room.replaceAll('-', ' ');
---
<section class:list={['academy-world', `academy-world--${mode}`]} data-academy-world data-room={resolvedRoom} data-week={week} data-mode={mode} data-demo-control={mode === 'demo' ? 'false' : undefined} data-base={base} aria-label={`${title} interactive environment`}>
  <div class="immersive-bar" data-immersive-bar hidden>
    <div><strong data-immersive-objective>{mode === 'demo' ? 'WORKED EXAMPLE' : 'MISSION IN PROGRESS'}</strong><span data-immersive-input-status role="status">Cursor free · Drag to turn · X locks cursor · Esc exits.</span></div>
    <div class="immersive-actions"><button type="button" data-immersive-controls>Mission &amp; controls</button><button type="button" data-immersive-task>Task controls</button><button type="button" data-immersive-look aria-pressed="false" aria-keyshortcuts="X">Lock cursor (X)</button><button type="button" data-immersive-exit>Exit fullscreen</button></div>
  </div>
  <div class="world-stage">
    <div class="world-poster">
      <img src={`${base}/world/academy-poster.svg`} width="1200" height="675" alt="An original academy with bronze arches, a central mechanism and illuminated workbenches." loading={mode === 'hero' ? 'eager' : 'lazy'} />
      <div class="world-poster-copy"><span class="world-eyebrow">{mode === "demo" ? "SLOPU · GUIDED WORKED EXAMPLE" : "SLOPU · FIELD FACILITY 408"}</span><h2>{title}</h2><p>{mode === "demo" ? "Watch the complete alternate example. Take control of the equipment whenever you are ready." : "Explore the room. Inspect its instruments. Put the lesson into motion."}</p><button type="button" class="world-launch" data-world-launch>{mode === "demo" ? "Open the demonstration stage" : "Enter the 3D environment"} <span aria-hidden="true">↗</span></button><span class="world-download">{mode === "demo" ? "An alternate example · separate from your assessed work" : "Loads on request · all equipment also has accessible controls below"}</span></div>
    </div>
    <div class="world-canvas" data-world-canvas hidden></div>
    <div class="world-hud" data-world-hud hidden tabindex="0" role="region" aria-label="Scene updates"><span class="world-location" data-world-location>{mode === "demo" ? "WORKED EXAMPLE / " + title : title}</span><span class="world-status" data-world-status role="status" aria-live="polite">Ready to explore.</span></div>
    <div class="world-demo-badge" data-world-demo-badge hidden><span aria-hidden="true">◉</span><span data-world-demo-mode>WATCHING A WORKED EXAMPLE</span></div><div class="world-object" data-world-object hidden><span data-world-object-label>Equipment</span><button data-world-inspect type="button">Inspect equipment</button><button data-world-use type="button">Use equipment</button><button data-world-exit-inspect type="button" hidden>Return to exploration</button></div>
    <div class="world-loading" data-world-loading hidden role="status"><span class="world-loader" aria-hidden="true"></span><strong>{mode === "demo" ? "Preparing the demonstration" : "Opening the academy"}</strong><span>Preparing the room, character and equipment…</span></div>
  </div>
  <div class="world-toolbar" data-world-toolbar hidden>
    <div class="world-control-group"><label>Graphics <select data-world-quality><option value="auto">Automatic</option><option value="low">Lightweight</option><option value="high">Detailed</option></select></label><button data-world-pause type="button" aria-pressed="false">Pause</button><button data-world-reset-camera type="button">Reset camera</button><button data-world-zoom-in type="button" aria-label="Zoom in">Zoom +</button><button data-world-zoom-out type="button" aria-label="Zoom out">Zoom −</button><button data-world-fullscreen type="button">Fullscreen mission</button></div>
    <label class="world-tool-label">Instrument <select data-world-equipment aria-label="Choose equipment to inspect"></select></label><label class="world-travel-label">Travel <select data-world-travel aria-label="Travel directly to a room"></select></label>
  </div>
  <aside class="immersive-console" data-immersive-console aria-label="Mission instructions and activity controls" hidden tabindex="-1"><p class="immersive-console-intro">Follow the mission steps here. Perform the practical task first; write your reflection afterwards. Scroll this panel to reach all controls.</p><div data-immersive-content></div></aside>
  <details class="world-instructions"><summary>How to move, inspect and complete the activity</summary><p>Use <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> or arrow keys to walk. Press <kbd>E</kbd> near an instrument to examine it. <strong>Inspect</strong> means read its details; <strong>Use equipment</strong> performs the action named in its status message. The labelled lesson controls let you choose exact settings and check your work.</p><p>Scroll over the scene or use <strong>Zoom + / Zoom −</strong> for a closer or wider view. Click and drag to turn whenever the cursor is free. Choose <strong>Fullscreen mission</strong> to keep the scene, mission instructions and all task controls together. Fullscreen starts with a free cursor so you can scroll the panel and choose options. Press <kbd>X</kbd> or <strong>Lock cursor (X)</strong> to turn by moving the mouse. Press <kbd>X</kbd> again to free the cursor and return to click-and-drag turning. <kbd>Tab</kbd> also frees the cursor. The X shortcut stays inactive while typing or choosing a form value. Press <kbd>Escape</kbd> or <strong>Exit fullscreen</strong> to return to the page. On touchscreens, drag to look and use the zoom buttons. If your browser cannot enter native fullscreen, the mission expands to fill its window.</p><p>{mode === "demo" ? "Choose Watch to follow the worked example, or Take control to try it yourself. The transcript and completed example remain available if 3D is unavailable. Demonstrations never change assessed progress." : "The activity below also works without 3D. Follow its objective and feedback, then save your record. Walking around the scene is optional and does not complete the lab by itself. The campus worksheet provides a printable alternative."}</p></details>
  <noscript><p class="world-noscript">{mode === "demo" ? "The complete transcript and finished example below are available without JavaScript." : "The illustrated room and all course instructions are available without JavaScript. Follow the static worksheet in this lab to complete the activity."}</p></noscript>
</section>
<script>
  import { registerAcademyScenes } from '../game/boot';
  registerAcademyScenes();
</script>
